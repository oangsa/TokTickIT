# Copy to server/.env and fill in your own PostgreSQL credentials.
# Never commit real credentials.

# Application connection (may go through a connection pooler).
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@<HOST>:5432/<DATABASE>?schema=public"

# Direct connection used by Prisma migrations. Only needed when DATABASE_URL
# points at a pooler; otherwise leave it unset.
DIRECT_URL="postgresql://<USERNAME>:<PASSWORD>@<HOST>:5432/<DATABASE>"

PORT=3000
