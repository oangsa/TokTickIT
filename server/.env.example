# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
# Direct (non-pooled) connection used by prisma migrate. Same as DATABASE_URL
# on a plain local Postgres; a session-mode URL when the app connects via a pooler.
DIRECT_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS="http://localhost:5173"
JWT_SECRET="<JWT_SECRET_AT_LEAST_32_CHARACTERS>"

# Lab 3 PostgreSQL commands require explicit disposable-target overrides and
# captured baseline identities. Keep these operator-local; do not commit real
# connection strings.
# TEST_DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:55432/toktickit_lab3_test"
# LAB3_BASELINE_DATABASE_URL="<captured normal DATABASE_URL>"
# LAB3_BASELINE_DIRECT_URL="<captured normal DIRECT_URL>"
