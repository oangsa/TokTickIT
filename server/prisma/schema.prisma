// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Pooled connections (pgbouncer) cannot run migrations; DIRECT_URL is the
  // session-mode connection the migration engine uses.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Issue 3 — IT request categories
// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}
