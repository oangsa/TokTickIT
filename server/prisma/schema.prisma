// Prisma schema — source of truth for the Lab 3 data model.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum SessionStage {
  PASSWORD_CHANGE_REQUIRED
  FULL
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum ActionTakenStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketActivityType {
  MIGRATED_TICKET_SNAPSHOT
  TICKET_ASSIGNED
  TICKET_REASSIGNED
  TICKET_UNASSIGNED
  IT_PRIORITY_CHANGED
  TICKET_STARTED_WORK
  INFORMATION_REQUESTED
  TICKET_RESUMED
  TICKET_MARKED_RESOLVED
  REQUESTER_RESOLUTION_CONFIRMED
  TICKET_CLOSED
  TICKET_CANCELLED
  TICKET_REOPENED
  ACTION_CREATED
  ACTION_UPDATED
  ACTION_ASSIGNED
  ACTION_REASSIGNED
  ACTION_UNASSIGNED
  ACTION_STARTED
  ACTION_COMPLETED
  ACTION_CANCELLED
}

enum LoginRateLimitScope {
  EMAIL_IP
  IP
}

model User {
  id                 Int      @id @default(autoincrement()) @map("id")
  publicId           String   @unique(map: "user_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  name               String   @map("name") @db.VarChar(100)
  email              String   @unique(map: "user_email_key") @map("email") @db.Citext
  role               UserRole @map("role")
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  isActive           Boolean  @default(true) @map("is_active")
  isSystem           Boolean  @default(false) @map("is_system")
  deleted            Boolean  @default(false) @map("deleted")
  createdBy          String   @map("created_by") @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy          String   @map("updated_by") @db.VarChar(255)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requesterTickets   Ticket[]            @relation("RequesterTickets")
  ownedTickets       Ticket[]            @relation("TicketOwners")
  attachments        Attachment[]        @relation("AttachmentUploader")
  idempotencyRecords IdempotencyRecord[] @relation("UserIdempotencyRecords")
  sessions           UserSession[]       @relation("UserSessions")
  publicComments     PublicComment[]     @relation("PublicCommentAuthors")
  internalNotes      InternalNote[]      @relation("InternalNoteAuthors")
  createdActions     ActionTaken[]       @relation("ActionCreators")
  assignedActions    ActionTaken[]       @relation("ActionAssignees")
  performedActions   ActionTaken[]       @relation("ActionPerformers")
  ticketActivities   TicketActivity[]    @relation("TicketActivityActors")
  previousTicketOwners TicketAssignmentActivity[] @relation("PreviousTicketAssignment")
  assignedTickets    TicketAssignmentActivity[] @relation("AssignedTicketOwner")
  previousActionAssignees ActionTakenActivity[] @relation("PreviousActionAssignee")
  assignedActionsInActivity ActionTakenActivity[] @relation("ActionActivityAssignee")

  @@index([role, isActive, deleted], map: "user_role_active_deleted_idx")
  @@map("user")
}

model UserSession {
  id                        String       @id @default(uuid()) @map("id") @db.Uuid
  userId                    Int          @map("user_id")
  stage                     SessionStage @map("stage")
  rememberMe                Boolean      @default(false) @map("remember_me")
  refreshTokenHash          String       @unique(map: "user_session_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  previousRefreshTokenHash  String?      @map("previous_refresh_token_hash") @db.Char(64)
  previousRefreshValidUntil DateTime?    @map("previous_refresh_valid_until") @db.Timestamptz(3)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt                DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(3)
  absoluteExpiresAt         DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt                 DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokeReason              String?      @map("revoke_reason") @db.VarChar(100)
  userAgent                 String?      @map("user_agent") @db.VarChar(512)
  ipAddress                 String?      @map("ip_address") @db.VarChar(64)

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, absoluteExpiresAt], map: "user_session_user_active_idx")
  @@index([absoluteExpiresAt, id], map: "user_session_expiry_idx")
  @@index([revokedAt, id], map: "user_session_revoked_idx")
  @@map("user_session")
}

model LoginRateLimitBucket {
  id              Int                 @id @default(autoincrement()) @map("id")
  scope           LoginRateLimitScope @map("scope")
  bucketKeyHash   String              @map("bucket_key_hash") @db.Char(64)
  windowStartedAt DateTime            @map("window_started_at") @db.Timestamptz(3)
  failureCount    Int                 @default(0) @map("failure_count")
  blockedUntil    DateTime?           @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, bucketKeyHash], map: "login_rate_limit_scope_key_hash_key")
  @@index([blockedUntil, windowStartedAt, id], map: "login_rate_limit_cleanup_idx")
  @@map("login_rate_limit_bucket")
}

model Category {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @unique(map: "category_name_key") @map("name") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  deleted   Boolean  @default(false) @map("deleted")
  createdBy String   @map("created_by") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by") @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[] @relation("CategoryTickets")

  @@map("category")
}

model RelatedSystem {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @unique(map: "related_system_name_key") @map("name") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  deleted   Boolean  @default(false) @map("deleted")
  createdBy String   @map("created_by") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by") @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[] @relation("RelatedSystemTickets")

  @@map("related_system")
}

model Ticket {
  id                             Int               @id @default(autoincrement()) @map("id")
  publicId                       String            @unique(map: "ticket_public_id_key") @map("public_id") @db.Uuid
  ticketNumber                   String            @unique(map: "ticket_ticket_number_key") @map("ticket_number") @db.VarChar(25)
  requesterId                    Int               @map("requester_id")
  ownerUserId                    Int?              @map("owner_user_id")
  categoryId                     Int               @map("category_id")
  relatedSystemId                Int               @map("related_system_id")
  summary                        String            @map("summary") @db.VarChar(150)
  requestedPriority              RequestedPriority @map("requested_priority")
  itPriority                     TicketPriority    @default(LOW) @map("it_priority")
  description                    String            @map("description") @db.VarChar(2000)
  currentStatus                  TicketStatus      @default(NEW) @map("current_status")
  requesterResolutionConfirmedAt DateTime?         @map("requester_resolution_confirmed_at") @db.Timestamptz(3)
  deleted                        Boolean           @default(false) @map("deleted")
  createdBy                      String            @map("created_by") @db.VarChar(255)
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy                      String            @map("updated_by") @db.VarChar(255)
  updatedAt                      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester          User                @relation("RequesterTickets", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner              User?               @relation("TicketOwners", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category           Category            @relation("CategoryTickets", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  relatedSystem      RelatedSystem       @relation("RelatedSystemTickets", fields: [relatedSystemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments        Attachment[]        @relation("TicketAttachments")
  idempotencyRecords IdempotencyRecord[] @relation("TicketIdempotencyRecords")
  publicComments     PublicComment[]     @relation("TicketPublicComments")
  internalNotes      InternalNote[]      @relation("TicketInternalNotes")
  actionsTaken       ActionTaken[]
  activities         TicketActivity[]

  @@index([ownerUserId, currentStatus, createdAt], map: "ticket_owner_status_created_idx")
  @@index([categoryId], map: "ticket_category_id_idx")
  @@index([relatedSystemId], map: "ticket_related_system_id_idx")
  @@index([requestedPriority], map: "ticket_requested_priority_idx")
  @@index([itPriority], map: "ticket_it_priority_idx")
  @@index([currentStatus], map: "ticket_current_status_idx")
  @@index([currentStatus, itPriority], map: "ticket_dashboard_status_priority_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "ticket_updated_recent_idx")
  @@index([ticketNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "ticket_ticket_number_trgm_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "ticket_summary_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "ticket_description_trgm_idx")
  @@map("ticket")
}

model Attachment {
  id                    Int      @id @default(autoincrement()) @map("id")
  storageKey            String   @unique(map: "attachment_storage_key_key") @map("storage_key") @db.Uuid
  ticketId              Int?     @map("ticket_id")
  uploadedByRequesterId Int      @map("uploaded_by_user_id")
  originalName          String   @map("original_name") @db.VarChar(255)
  extension             String   @map("extension") @db.VarChar(10)
  mimeType              String   @map("mime_type") @db.VarChar(50)
  sizeBytes             Int      @map("size_bytes")
  data                  Bytes    @map("data")
  removalReason         String?  @map("removal_reason") @db.VarChar(200)
  deleted               Boolean  @default(false) @map("deleted")
  createdBy             String   @map("created_by") @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy             String   @map("updated_by") @db.VarChar(255)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket              Ticket? @relation("TicketAttachments", fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedByRequester User    @relation("AttachmentUploader", fields: [uploadedByRequesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actionAssociations ActionTakenAttachment[]

  @@index([ticketId], map: "attachment_ticket_id_idx")
  @@index([uploadedByRequesterId, ticketId], map: "attachment_uploader_ticket_idx")
  @@map("attachment")
}

model IdempotencyRecord {
  id                  Int               @id @default(autoincrement()) @map("id")
  userId              Int               @map("user_id")
  key                 String            @map("key") @db.Uuid
  method              String            @map("method") @db.VarChar(10)
  resourcePath        String            @map("resource_path") @db.VarChar(512)
  requestHash         String            @map("request_hash") @db.VarChar(128)
  status              IdempotencyStatus @map("status")
  processingStartedAt DateTime          @map("processing_started_at") @db.Timestamptz(3)
  ticketId            Int?              @map("ticket_id")
  actionTakenId       Int?              @map("action_taken_id")
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  expiresAt           DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdBy           String            @map("created_by") @db.VarChar(255)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy           String            @map("updated_by") @db.VarChar(255)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation("UserIdempotencyRecords", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticket      Ticket?      @relation("TicketIdempotencyRecords", fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actionTaken ActionTaken? @relation("ActionIdempotencyRecords", fields: [actionTakenId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, method, resourcePath, key], map: "idempotency_record_user_method_path_key_key")
  @@index([expiresAt, id], map: "idempotency_record_expires_at_id_idx")
  @@map("idempotency_record")
}

model ActionTaken {
  id                 Int               @id @default(autoincrement()) @map("id")
  publicId           String            @unique(map: "action_taken_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  ticketId           Int               @map("ticket_id")
  creatorUserId      Int               @map("creator_user_id")
  assignedToUserId   Int?              @map("assigned_to_user_id")
  performedByUserId  Int?              @map("performed_by_user_id")
  status             ActionTakenStatus @map("status")
  description        String            @map("description") @db.VarChar(2000)
  result             String?           @map("result") @db.VarChar(2000)
  followUpRequired   Boolean           @map("follow_up_required")
  followUpNote       String?           @map("follow_up_note") @db.VarChar(2000)
  attachmentNotes    String?           @map("attachment_notes") @db.VarChar(2000)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  isMigrated         Boolean           @default(false) @map("is_migrated")
  version            Int               @default(1) @map("version")
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdBy          String            @map("created_by") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy          String            @map("updated_by") @db.VarChar(255)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket             Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator            User                    @relation("ActionCreators", fields: [creatorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedTo         User?                   @relation("ActionAssignees", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  performedBy        User?                   @relation("ActionPerformers", fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments        ActionTakenAttachment[]
  activities         ActionTakenActivity[]
  idempotencyRecords IdempotencyRecord[]     @relation("ActionIdempotencyRecords")

  @@index([ticketId, createdAt(sort: Desc), id(sort: Desc)], map: "action_taken_ticket_created_idx")
  @@index([assignedToUserId, status], map: "action_taken_assignee_status_idx")
  @@index([performedByUserId, completedAt], map: "action_taken_performer_completed_idx")
  @@index([status, ticketId], map: "action_taken_status_ticket_idx")
  @@map("action_taken")
}

model ActionTakenAttachment {
  actionTakenId Int      @map("action_taken_id")
  attachmentId  Int      @map("attachment_id")
  createdBy     String   @map("created_by") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy     String   @map("updated_by") @db.VarChar(255)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  actionTaken ActionTaken @relation(fields: [actionTakenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachment  Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([actionTakenId, attachmentId], map: "action_taken_attachment_pkey")
  @@index([attachmentId], map: "action_taken_attachment_attachment_idx")
  @@map("action_taken_attachment")
}

model TicketActivity {
  id                Int                @id @default(autoincrement()) @map("id")
  publicId          String             @unique(map: "ticket_activity_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  ticketId          Int                @map("ticket_id")
  performedByUserId Int                @map("performed_by_user_id")
  action            TicketActivityType @map("action")
  createdBy         String             @map("created_by") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy         String             @map("updated_by") @db.VarChar(255)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)

  ticket      Ticket                    @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  performedBy User                      @relation("TicketActivityActors", fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment  TicketAssignmentActivity?
  status      TicketStatusActivity?
  priority    TicketPriorityActivity?
  actionTaken ActionTakenActivity?

  @@index([ticketId, createdAt(sort: Desc), id(sort: Desc)], map: "ticket_activity_ticket_created_idx")
  @@map("ticket_activity")
}

model TicketAssignmentActivity {
  ticketActivityId        Int  @id @map("ticket_activity_id")
  previousAssignedToUserId Int? @map("previous_assigned_to_user_id")
  assignedToUserId         Int? @map("assigned_to_user_id")

  activity      TicketActivity @relation(fields: [ticketActivityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousOwner User?          @relation("PreviousTicketAssignment", fields: [previousAssignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedOwner User?          @relation("AssignedTicketOwner", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ticket_assignment_activity")
}

model TicketStatusActivity {
  ticketActivityId Int          @id @map("ticket_activity_id")
  previousStatus   TicketStatus? @map("previous_status")
  status           TicketStatus  @map("status")

  activity TicketActivity @relation(fields: [ticketActivityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ticket_status_activity")
}

model TicketPriorityActivity {
  ticketActivityId Int            @id @map("ticket_activity_id")
  previousPriority TicketPriority? @map("previous_priority")
  priority         TicketPriority  @map("priority")

  activity TicketActivity @relation(fields: [ticketActivityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ticket_priority_activity")
}

model ActionTakenActivity {
  ticketActivityId        Int  @id @map("ticket_activity_id")
  actionTakenId           Int  @map("action_taken_id")
  previousAssignedToUserId Int? @map("previous_assigned_to_user_id")
  assignedToUserId         Int? @map("assigned_to_user_id")

  activity         TicketActivity @relation(fields: [ticketActivityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actionTaken      ActionTaken    @relation(fields: [actionTakenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousAssignee User?          @relation("PreviousActionAssignee", fields: [previousAssignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedAssignee User?          @relation("ActionActivityAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actionTakenId], map: "action_taken_activity_action_idx")
  @@map("action_taken_activity")
}

model PublicComment {
  id               Int      @id @default(autoincrement()) @map("id")
  publicId         String   @unique(map: "public_comment_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  ticketId         Int      @map("ticket_id")
  authorUserId     Int      @map("author_user_id")
  parentCommentId  Int?     @map("parent_comment_id")
  replyToCommentId Int?     @map("reply_to_comment_id")
  content          String   @map("content") @db.VarChar(2000)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket       Ticket          @relation("TicketPublicComments", fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author       User            @relation("PublicCommentAuthors", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent       PublicComment?  @relation("PublicCommentChildren", fields: [parentCommentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies      PublicComment[] @relation("PublicCommentChildren")
  replyTo      PublicComment?  @relation("PublicCommentReplyTargets", fields: [replyToCommentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replyTargets PublicComment[] @relation("PublicCommentReplyTargets")

  @@index([ticketId, parentCommentId, createdAt, id], map: "public_comment_thread_idx")
  @@index([replyToCommentId], map: "public_comment_reply_target_idx")
  @@map("public_comment")
}

model InternalNote {
  id           Int      @id @default(autoincrement()) @map("id")
  publicId     String   @unique(map: "internal_note_public_id_key") @default(uuid()) @map("public_id") @db.Uuid
  ticketId     Int      @map("ticket_id")
  authorUserId Int      @map("author_user_id")
  content      String   @map("content") @db.VarChar(4000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket @relation("TicketInternalNotes", fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author User   @relation("InternalNoteAuthors", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ticketId, createdAt, id], map: "internal_note_ticket_created_idx")
  @@map("internal_note")
}
